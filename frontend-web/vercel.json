{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/frontend-web/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://zentry-production-319f.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
